# 智能日报生成器配置模板
# 使用方式：复制为 config.yaml 后按团队实际情况修改；密钥一律用 ${环境变量} 占位。

team:
  name: 研发团队
  leader_email: leader@example.com
  timezone: Asia/Shanghai

# 采集范围：只采集这里列出的仓库
repos:
  - owner: wsh-dotcommer
    name: zuoye

# 成员映射表：把 GitHub 用户名/邮箱归一到「人」
members:
  - name: 红豆
    github_username: wsh-dotcommer
    github_emails:
      - 3011859592@qq.com
  - name: 示例成员A
    github_username: example-a
    github_emails: []
  - name: 示例成员B
    github_username: example-b
    github_emails: []

sources:
  github:
    token: ${GITHUB_TOKEN}          # 公开仓库可留空；未设置环境变量时按匿名访问
    include_others: false            # true 表示未映射到的作者也单独成段
    exclude_bots: true               # 默认排除机器人账号（如 dependabot[bot]）
    keywords: [feat, fix, docs, refactor, test, 日报, 规范, SDD]
    sensitive_keywords: [薪资, 绩效, 裁员, 期权, 人事, 调薪]
    max_commit_details: 100          # 单次最多获取多少条提交的变更统计
    max_issue_timelines: 50          # 单次最多查询多少个 Issue 的 timeline 事件
    per_page: 100
    retry_times: 3
    retry_interval_seconds: 5
    rate_limit_max_wait_seconds: 300
    timeout_seconds: 15
  feishu:                            # v2.3：飞书群消息作为只读数据源（只统计条数与人数）
    enabled: false                   # 默认关闭；填好下面的凭据与群 id 后再改成 true
    app_id: ${FEISHU_APP_ID}         # 填在 .env：企业自建应用的 App ID
    app_secret: ${FEISHU_APP_SECRET} # 填在 .env：企业自建应用的 App Secret
    base_url: https://open.feishu.cn
    chats:                           # 要统计的群；id 是 chat_id（oc_ 开头），name 只用于日报展示
      - id: oc_xxxxxxxxxxxxxxxx
        name: 智能日报
    retry_times: 3
    timeout_seconds: 15
    tasks:                           # v2.4：飞书任务状态同步（只读快照）
      enabled: false                 # 默认关闭；应用加好 task:task:read 权限并重新发布后再改成 true
      scope: all                     # all = 应用可见的全部任务；tasklist = 只同步下面列出的清单
      tasklist_guids: []             # scope: tasklist 时必填，如 [f8b3...：任务清单 URL 里的 guid]
      max_tasks: 200                 # 单次同步的任务数上限，超出部分不展示

report:
  output_dir: output                 # Markdown / HTML 日报输出目录
  site_dir: docs                     # 静态日报站输出目录（GitHub Pages 发布 main 分支 /docs）
  site_title: 智能日报
  workbench: true                    # true → 站点页内联「日报工作台」（v2.0）；false → 退回纯只读站
  storage_path: data/reports.sqlite3
  log_path: logs/daily-report.jsonl
  skip_weekends: true
  holidays: []                       # 法定节假日需自行维护，如 [2026-10-01, 2026-10-02]
  attribution:                       # v2.4：对外产物（邮件/飞书卡片/站点）末尾的「数据来源」标注
    enabled: true                    # false → 三端都不出现该行，产物回到 v2.3 的形态
    scope: 仅限团队内部日报展示        # 标注里的"授权使用范围"，按你们的实际约定改

# 工时统计（v1.1）：由提交时间按“会话法”推导，非真实考勤
hours:
  enabled: true
  gap_minutes: 60                    # 相邻提交间隔超过该分钟数即算新的工作段
  wrap_up_hours: 0.5                 # 每个工作段的收尾时长（只有一条提交的段按此计）
  rounding_hours: 0.5                # 结果四舍五入到的网格
  daily_cap_hours: 12                # 单人单日工时上限

notify:
  email:
    enabled: false
    host: smtp.example.com
    port: 465
    use_ssl: true
    sender: bot@example.com
    username: ${SMTP_USERNAME}
    password: ${SMTP_PASSWORD}
    recipients:
      - leader@example.com
  lark_bot:
    enabled: false                    # true → 不加 --dry-run 就会把日报推到飞书群
    webhook: ${LARK_BOT_WEBHOOK}      # 填在 .env：飞书群机器人 Webhook 地址
    secret: ""                        # 机器人安全设置选「签名校验」时改成 ${LARK_BOT_SECRET}
