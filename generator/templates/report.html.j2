{% extends "base.html.j2" %}
{% block content %}
    <section class="page-intro">
      <p class="eyebrow">Daily report</p>
      <h1>{{ view.heading }}</h1>
      <p class="intro-copy">日期：{{ view.date_label }} · 团队：{{ view.team_label }} · 生成时间：{{ view.generated_at }}</p>
{% if view.hours_summary %}
      <p class="intro-copy intro-hours">工时：团队合计 {{ view.hours_summary.total }}h · 人均 {{ view.hours_summary.average }}h（{{ view.hours_summary.note }}）</p>
{% endif %}
      <ul class="chips">
{% for source in view.source_summary %}
        <li class="{{ 'ok' if source.ok else 'failed' }}">{{ source.label }} {{ source.count }} 条{% if not source.ok %} · 数据获取失败{% endif %}</li>
{% endfor %}
      </ul>
{% if view.extra_lines %}
      <ul class="head-lines">
{% for line in view.extra_lines %}
        <li>{{ line }}</li>
{% endfor %}
      </ul>
{% endif %}
    </section>
{% if interactive %}
    <div class="action-row">
      <button class="button button-secondary" id="report-copy" type="button" data-date="{{ view.date }}">复制 Markdown</button>
      <button class="button button-secondary" id="report-load" type="button">载入到工作台</button>
    </div>
{% endif %}
{% if view.management %}
    <section class="panel management-panel" aria-labelledby="management-title">
      <div class="panel-heading">
        <div>
          <p class="panel-kicker">Management · 团队摘要</p>
          <h2 id="management-title">管理摘要</h2>
        </div>
        <span class="note-chip">先看进展，再看行动</span>
      </div>
      <section class="block management-block">
        <h3>今日概览</h3>
        <ul class="lines">
{% for item in view.management.overview %}
          <li>{{ item | inline_links }}</li>
{% endfor %}
{% if view.management.progress %}
          <li><strong>重点进展：</strong>{{ view.management.progress | join("；") | inline_links }}</li>
{% endif %}
        </ul>
      </section>
      <section class="block management-block">
        <h3>需要关注</h3>
        <ul class="lines">
{% for item in view.management.attention %}
          <li>{{ item | inline_links }}</li>
{% endfor %}
        </ul>
      </section>
      <section class="block management-block">
        <h3>下一步</h3>
        <ul class="lines">
{% for item in view.management.next_steps %}
          <li>{{ item | inline_links }}</li>
{% endfor %}
        </ul>
      </section>
    </section>
{% endif %}
{% for member in view.members %}
    <section class="panel">
{% if not view.single_member %}
      <div class="panel-heading">
        <div>
          <p class="panel-kicker">Member · 成员日报</p>
          <h2>{{ member.name }}<span class="username">@{{ member.github_username }}</span></h2>
        </div>
        <span class="avatar" aria-hidden="true">{{ member.name[:1] }}</span>
      </div>
{% endif %}
{% for section in member.sections %}
      <section class="block{% if section.sub %} block-sub{% endif %}">
        <div class="block-head">
{% if section.sub %}
          <h4>{{ section.title }}</h4>
{% else %}
          <h3>{{ section.title }}</h3>
{% endif %}
{% if section.state == "ok" and section.title != "工时统计" %}
          <span class="block-meta">{{ section.count if section.count is defined else section.lines|length }} 条</span>
{% endif %}
        </div>
{% if section.state == "ok" %}
{% if section.summary and section.key == "commits" %}
        <div class="commit-summary">
          <div class="commit-metrics">
            <div class="commit-metric">
              <span class="commit-metric-label">提交次数</span>
              <strong class="commit-metric-value">{{ section.summary.count }}<small>次</small></strong>
            </div>
            <div class="commit-metric">
              <span class="commit-metric-label">涉及文件</span>
              <strong class="commit-metric-value">{{ section.summary.file_count }}<small>个</small></strong>
            </div>
            <div class="commit-metric commit-metric-add">
              <span class="commit-metric-label">新增行</span>
              <strong class="commit-metric-value">+{{ section.summary.additions }}</strong>
            </div>
            <div class="commit-metric commit-metric-delete">
              <span class="commit-metric-label">删除行</span>
              <strong class="commit-metric-value">-{{ section.summary.deletions }}</strong>
            </div>
          </div>
{% if section.summary.change_total %}
          <div class="commit-change">
            <div class="commit-change-head">
              <span>增删构成</span>
              <span>共 {{ section.summary.change_total }} 行</span>
            </div>
            <div class="commit-change-track" role="img" aria-label="新增 {{ section.summary.additions }} 行，删除 {{ section.summary.deletions }} 行">
              <span class="commit-change-add" style="width: {{ section.summary.additions_percent }}%"></span>
              <span class="commit-change-delete" style="width: {{ section.summary.deletions_percent }}%"></span>
            </div>
          </div>
{% endif %}
          <div class="commit-breakdown">
            <div class="commit-group">
              <span class="commit-group-label">改动构成</span>
              <div class="commit-tags">
{% for item in section.summary.types %}
                <span class="commit-tag">{{ item.label }} <b>{{ item.count }}</b></span>
{% endfor %}
              </div>
            </div>
            <div class="commit-group">
              <span class="commit-group-label">仓库分布</span>
              <div class="commit-tags">
{% for item in section.summary.repos %}
                <span class="commit-tag commit-repo-tag">{{ item.name }} <b>{{ item.count }} 次</b></span>
{% endfor %}
              </div>
            </div>
          </div>
        </div>
{% else %}
        <ul class="lines">
{% for item in section.lines %}
          <li>{{ (item[2:] if item.startswith("- ") else item) | inline_links }}</li>
{% endfor %}
        </ul>
{% endif %}
{% elif section.state == "empty" %}
{% if section.merged %}
        <p class="empty-line">{{ section.note }}</p>
{% else %}
        <p class="empty-box">{{ section.note }}</p>
{% endif %}
{% else %}
        <p class="failed-box">{{ section.note }}</p>
{% endif %}
      </section>
{% endfor %}
    </section>
{% endfor %}
{% if view.attribution %}
    <p class="attribution">{{ view.attribution }}</p>
{% endif %}
{% if back_link %}
    <p class="back-link"><a class="button button-secondary" href="index.html">← 返回日报列表</a></p>
{% endif %}
{% endblock %}
{% block scripts %}
{% if interactive %}
  <script id="workbench-data" type="application/json">{{ workbench_data|safe }}</script>
  <script>{{ workbench_js|safe }}</script>
{% endif %}
{% endblock %}
